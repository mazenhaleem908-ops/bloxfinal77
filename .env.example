# --- Neon PostgreSQL ---------------------------------------------------------
# Neon dashboard -> your project -> Connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Resend (transactional email / OTP) --------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=business@bloxistar.com
RESEND_FROM_NAME=BloxStar

# --- Admin accounts (comma separated, lower case) ----------------------------
ADMIN_EMAILS=mazenhaleem908@gmail.com,kareemahmedhalim@gmail.com,sagedhalim9@gmail.com

# --- MoonPay -----------------------------------------------------------------
# The publishable key lives in public/storefront.html (MOONPAY_CFG.apiKey).
# Only set this if you add a server-side signed-URL endpoint later.
# MOONPAY_SECRET_KEY=sk_live_xxxxxxxxxxxx

# --- Session signing secret ---------------------------------------------------
# Any long random string (e.g. `openssl rand -hex 32`). Required on Vercel.
AUTH_SECRET=change-me-to-a-long-random-string

# --- Google Sign-In (OAuth 2.0 / OIDC) ---------------------------------------
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Add this exact Authorized redirect URI:
#   https://www.bloxistar.com/api/public/auth/google/callback
# and, for local testing, http://localhost:8080/api/public/auth/google/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# Optional: pin the redirect URI instead of deriving it from the request origin.
# GOOGLE_REDIRECT_URI=https://www.bloxistar.com/api/public/auth/google/callback

# Optional: Resend reply-to (defaults to RESEND_FROM_EMAIL)
# RESEND_REPLY_TO=business@bloxistar.com

# --- Supabase (Continue with Google) -----------------------------------------
# Supabase dashboard -> Project settings -> API.
# In Supabase: Authentication -> Providers -> Google (enable + Google client
# id/secret), and add this Redirect URL:
#   https://www.bloxistar.com/auth/callback
#   http://localhost:8080/auth/callback
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxx
